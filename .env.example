# Identity Provider (chạy riêng, chỉ một trung tâm dùng chung)
IDP_ISSUER=http://127.0.0.1:8001
DATABASE_URL=sqlite:///./users.db
JWT_SECRET=REPLACE_WITH_THE_SAME_LONG_RANDOM_SECRET_ON_IDP_AND_WEB_SERVICES
ADMIN_USERNAME=admin
ADMIN_PASSWORD=REPLACE_WITH_A_STRONG_ADMIN_PASSWORD

# Đăng ký các Web Service tại IdP. Mỗi service có client_id/client_secret riêng.
# client_secret nên tạo ngẫu nhiên tối thiểu 32 bytes và không commit lên Git.
OAUTH_CLIENTS_JSON=[{"client_id":"iris-web-local","client_name":"Iris ML Web Service","client_secret":"REPLACE_WITH_RANDOM_SECRET_AT_LEAST_24_CHARS","redirect_uris":["http://127.0.0.1:8000"],"scopes":["iris:access","iris:predict","iris:history"],"active":true}]

# Web Service Iris (đặt ở môi trường chạy app.py; cùng JWT_SECRET và issuer)
AUTH_SERVICE_URL=http://127.0.0.1:8001
OAUTH_CLIENT_ID=iris-web-local
OAUTH_CLIENT_SECRET=REPLACE_WITH_THE_SAME_CLIENT_SECRET_AS_IDP
OAUTH_REQUIRED_SCOPE=iris:access
